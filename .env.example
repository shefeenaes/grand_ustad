# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.grandustad.com

# EmailJS (contact form). Find these at https://dashboard.emailjs.com
#   Service ID:  Email Services > your service
#   Template ID: Email Templates > your template (content in docs/emailjs-contact-template.html)
#   Public Key:  Account > General > Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
